<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Cosmos.Sdk" Version="3.0.86" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <GCCCompilerFlags>-ffreestanding -g -fno-stack-protector -O2 -fno-stack-protector -nostdinc -fno-builtin -march=x86-64</GCCCompilerFlags> <!-- Enable debug symbol for C-->
    <CosmosEnableStorage>true</CosmosEnableStorage>
  </PropertyGroup>

  <ItemGroup>
    <GCCProject Include="./src/C/" />
    <AsmSearchPath Include="./src/asm"/>
    <DirectPInvoke Include="load_gdt"/>
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="init.tar" />
  </ItemGroup>


  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.86" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.86" />
  </ItemGroup>

</Project>
